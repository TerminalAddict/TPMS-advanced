CREATE TABLE AlertEvent (
    id TEXT NOT NULL PRIMARY KEY,
    eventKey TEXT NOT NULL,
    vehicleId TEXT NOT NULL,
    vehicleName TEXT NOT NULL,
    wheel TEXT NOT NULL,
    sensorId INTEGER,
    kind TEXT NOT NULL,
    severity TEXT NOT NULL,
    started REAL NOT NULL,
    lastSeen REAL NOT NULL,
    ended REAL,
    dismissed REAL,
    resolution TEXT
);
CREATE INDEX alert_event_time ON AlertEvent(started);
CREATE INDEX alert_event_vehicle_time ON AlertEvent(vehicleId, started);

CREATE TABLE RideReport (
    id TEXT NOT NULL PRIMARY KEY,
    vehicleId TEXT NOT NULL,
    vehicleName TEXT NOT NULL,
    started REAL NOT NULL,
    lastSeen REAL NOT NULL,
    ended REAL,
    reason TEXT,
    expected TEXT NOT NULL,
    gapSeconds REAL NOT NULL,
    summary TEXT
);
CREATE INDEX ride_report_time ON RideReport(started);

openEvents:
SELECT * FROM AlertEvent WHERE ended IS NULL;

insertEvent:
INSERT INTO AlertEvent(id,eventKey,vehicleId,vehicleName,wheel,sensorId,kind,severity,started,lastSeen)
VALUES (?,?,?,?,?,?,?,?,?,?);

touchEvent:
UPDATE AlertEvent SET lastSeen = ? WHERE id = ?;

endEvent:
UPDATE AlertEvent SET ended = ?, resolution = ? WHERE id = ? AND ended IS NULL;

dismissEvent:
UPDATE AlertEvent SET dismissed = ? WHERE id = ? AND dismissed IS NULL;

searchEvents:
SELECT * FROM AlertEvent WHERE vehicleName LIKE :search OR wheel LIKE :search OR kind LIKE :search
    OR severity LIKE :search OR CAST(sensorId AS TEXT) LIKE :search
ORDER BY started DESC, id LIMIT :pageSize OFFSET :pageOffset;

countRideAlerts:
SELECT COUNT(*) FROM AlertEvent WHERE vehicleId = :vehicleId
AND (ended IS NULL OR ended >= :start) AND started <= :end;

insertRide:
INSERT INTO RideReport(id,vehicleId,vehicleName,started,lastSeen,expected,gapSeconds) VALUES (?,?,?,?,?,?,?);

openRides:
SELECT * FROM RideReport WHERE ended IS NULL;

touchRides:
UPDATE RideReport SET lastSeen = ? WHERE id = ? AND ended IS NULL;

endRide:
UPDATE RideReport SET ended = ?, reason = ?, summary = ? WHERE id = ? AND ended IS NULL;

ridesPage:
SELECT * FROM RideReport ORDER BY started DESC, id LIMIT ? OFFSET ?;

countEvents:
SELECT COUNT(*) FROM AlertEvent;

countRides:
SELECT COUNT(*) FROM RideReport;

countOldEvents:
SELECT COUNT(*) FROM AlertEvent WHERE ended IS NOT NULL AND ended < ?;

countOldRides:
SELECT COUNT(*) FROM RideReport WHERE ended IS NOT NULL AND ended < ? AND summary IS NOT NULL;

oldEvents:
SELECT * FROM AlertEvent WHERE ended IS NOT NULL AND ended < ? ORDER BY id LIMIT ? OFFSET ?;

oldRides:
SELECT * FROM RideReport WHERE ended IS NOT NULL AND ended < ? AND summary IS NOT NULL ORDER BY id LIMIT ? OFFSET ?;

pruneEvents:
DELETE FROM AlertEvent WHERE ended IS NOT NULL AND ended < ?;

pruneRides:
DELETE FROM RideReport WHERE ended IS NOT NULL AND ended < ? AND summary IS NOT NULL;
