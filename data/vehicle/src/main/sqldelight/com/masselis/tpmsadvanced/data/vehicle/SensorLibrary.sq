CREATE TABLE SensorInventory (
    id INTEGER NOT NULL PRIMARY KEY,
    label TEXT NOT NULL DEFAULT '',
    manufacturer TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT '',
    protocol TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    firstSeen REAL,
    lastSeen REAL,
    voltage REAL,
    percent INTEGER,
    pressure REAL,
    temperature REAL,
    warning TEXT,
    warningAt REAL
);

CREATE TABLE SensorInstallation (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sensorId INTEGER NOT NULL,
    vehicleId TEXT NOT NULL,
    vehicleName TEXT NOT NULL,
    location INTEGER NOT NULL,
    started REAL NOT NULL,
    ended REAL,
    origin TEXT NOT NULL DEFAULT 'Assignment'
);
CREATE INDEX sensor_installation_id ON SensorInstallation(sensorId, started);

CREATE TABLE SensorHealthDaily (
    sensorId INTEGER NOT NULL,
    day INTEGER NOT NULL,
    packets INTEGER NOT NULL,
    rssiTotal INTEGER NOT NULL,
    rssiCount INTEGER NOT NULL,
    voltageTotal REAL NOT NULL,
    voltageCount INTEGER NOT NULL,
    percentTotal REAL NOT NULL,
    percentCount INTEGER NOT NULL,
    observedSeconds REAL NOT NULL,
    missed INTEGER NOT NULL,
    longestGap REAL NOT NULL,
    questionable INTEGER NOT NULL,
    PRIMARY KEY(sensorId, day)
);

CREATE TABLE SensorIssue (
    issueKey TEXT NOT NULL PRIMARY KEY,
    sensorId INTEGER,
    address TEXT NOT NULL,
    reason TEXT NOT NULL,
    firstSeen REAL NOT NULL,
    lastSeen REAL NOT NULL,
    occurrences INTEGER NOT NULL,
    packet TEXT NOT NULL
);
CREATE INDEX sensor_issue_last ON SensorIssue(lastSeen);

CREATE TABLE SensorRadioIdentity (address TEXT NOT NULL PRIMARY KEY, sensorId INTEGER NOT NULL);

CREATE TRIGGER sensor_library_insert AFTER INSERT ON Sensor BEGIN
    INSERT INTO SensorInventory(id) SELECT new.id WHERE NOT EXISTS (SELECT 1 FROM SensorInventory WHERE id = new.id);
    INSERT INTO SensorInstallation(sensorId, vehicleId, vehicleName, location, started)
    VALUES (new.id, new.vehicleId, (SELECT name FROM Vehicle WHERE uuid = new.vehicleId), new.location,
        CAST(strftime('%s','now') AS REAL));
END;

CREATE TRIGGER sensor_library_move AFTER UPDATE OF vehicleId, location ON Sensor
WHEN old.vehicleId != new.vehicleId OR old.location != new.location BEGIN
    UPDATE SensorInstallation SET ended = CAST(strftime('%s','now') AS REAL)
    WHERE sensorId = old.id AND ended IS NULL;
    INSERT INTO SensorInventory(id) SELECT new.id WHERE NOT EXISTS (SELECT 1 FROM SensorInventory WHERE id = new.id);
    INSERT INTO SensorInstallation(sensorId, vehicleId, vehicleName, location, started)
    VALUES (new.id, new.vehicleId, (SELECT name FROM Vehicle WHERE uuid = new.vehicleId), new.location,
        CAST(strftime('%s','now') AS REAL));
END;

CREATE TRIGGER sensor_library_remove AFTER DELETE ON Sensor BEGIN
    UPDATE SensorInstallation SET ended = CAST(strftime('%s','now') AS REAL)
    WHERE sensorId = old.id AND ended IS NULL;
END;

inventory:
SELECT * FROM SensorInventory ORDER BY lastSeen DESC, id;

sensor:
SELECT * FROM SensorInventory WHERE id = ?;

ensureSensor:
INSERT OR IGNORE INTO SensorInventory(id) VALUES (?);

saveMetadata:
UPDATE SensorInventory SET label = ?, manufacturer = ?, notes = ? WHERE id = ?;

seen:
UPDATE SensorInventory SET protocol = ?, address = ?, firstSeen = COALESCE(firstSeen, :time), lastSeen = :time,
voltage = ?, percent = ?, pressure = ?, temperature = ?, warning = ?, warningAt = :time
WHERE id = ? AND (lastSeen IS NULL OR lastSeen <= :time);

markWarning:
UPDATE SensorInventory SET warning = ?, warningAt = ? WHERE id = ?;

radioIdentity:
SELECT sensorId FROM SensorRadioIdentity WHERE address = ?;

rememberIdentity:
INSERT INTO SensorRadioIdentity(address, sensorId) VALUES (?, ?)
ON CONFLICT(address) DO UPDATE SET sensorId = excluded.sensorId;

installations:
SELECT * FROM SensorInstallation WHERE sensorId = ? ORDER BY started DESC, id DESC LIMIT 200;

daily:
SELECT * FROM SensorHealthDaily WHERE sensorId = ? AND day >= ? ORDER BY day;

addDaily:
INSERT INTO SensorHealthDaily(sensorId, day, packets, rssiTotal, rssiCount, voltageTotal, voltageCount,
percentTotal, percentCount, observedSeconds, missed, longestGap, questionable)
VALUES (?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(sensorId, day) DO UPDATE SET packets = packets + 1,
rssiTotal = rssiTotal + excluded.rssiTotal, rssiCount = rssiCount + excluded.rssiCount,
voltageTotal = voltageTotal + excluded.voltageTotal, voltageCount = voltageCount + excluded.voltageCount,
percentTotal = percentTotal + excluded.percentTotal, percentCount = percentCount + excluded.percentCount,
observedSeconds = observedSeconds + excluded.observedSeconds, missed = missed + excluded.missed,
longestGap = MAX(longestGap, excluded.longestGap), questionable = questionable + excluded.questionable;

issue:
INSERT INTO SensorIssue(issueKey, sensorId, address, reason, firstSeen, lastSeen, occurrences, packet)
VALUES (?, ?, ?, ?, :time, :time, 1, ?)
ON CONFLICT(issueKey) DO UPDATE SET lastSeen = excluded.lastSeen, occurrences = occurrences + 1,
packet = excluded.packet;

issues:
SELECT * FROM SensorIssue WHERE :sensorId IS NULL OR sensorId = :sensorId ORDER BY lastSeen DESC LIMIT 200;

trimIssues:
DELETE FROM SensorIssue WHERE issueKey NOT IN (SELECT issueKey FROM SensorIssue ORDER BY lastSeen DESC LIMIT 1000);

healthCount:
SELECT COUNT(*) FROM SensorHealthDaily;

installationCount:
SELECT COUNT(*) FROM SensorInstallation;

issueCount:
SELECT COUNT(*) FROM SensorIssue;

oldHealthCount:
SELECT COUNT(*) FROM SensorHealthDaily WHERE day < ?;

oldHealth:
SELECT * FROM SensorHealthDaily WHERE day < ? ORDER BY sensorId, day LIMIT ? OFFSET ?;

pruneHealth:
DELETE FROM SensorHealthDaily WHERE day < ?;
