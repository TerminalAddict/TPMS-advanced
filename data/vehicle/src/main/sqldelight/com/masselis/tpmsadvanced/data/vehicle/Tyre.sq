import com.masselis.tpmsadvanced.data.vehicle.model.Pressure;
import com.masselis.tpmsadvanced.data.vehicle.model.Temperature;
import com.masselis.tpmsadvanced.data.vehicle.model.Location;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;
import kotlin.UShort;

CREATE TABLE Tyre(
    id INTEGER AS Int NOT NULL,
    timestamp REAL NOT NULL,
    rssi INTEGER AS Int NOT NULL,
    location INTEGER AS Location NOT NULL,
    pressure REAL AS Pressure NOT NULL,
    temperature REAL AS Temperature NOT NULL,
    battery INTEGER AS UShort NOT NULL,
    isAlarm INTEGER AS Boolean NOT NULL,
    vehicleId TEXT AS UUID NOT NULL,
    batteryVoltage REAL,
    batteryPercent INTEGER,
    FOREIGN KEY(vehicleId) REFERENCES Vehicle(uuid) ON DELETE CASCADE
);

CREATE INDEX tyre_vehicle_time ON Tyre(vehicleId, timestamp);
CREATE INDEX tyre_vehicle_sensor_time ON Tyre(vehicleId, id, timestamp);

historyPage:
SELECT id, timestamp, rssi, location, pressure, temperature, battery, isAlarm, batteryVoltage, batteryPercent
FROM Tyre WHERE vehicleId = ? AND timestamp >= ? AND timestamp <= ?
ORDER BY timestamp, rowid LIMIT ? OFFSET ?;

insert:
INSERT INTO Tyre (id, timestamp, rssi, location, pressure, temperature, battery, isAlarm, vehicleId, batteryVoltage, batteryPercent) VALUES (?, ?,?, ?, ?, ?, ?, ?, ?, ?, ?);

latestByTyreLocationByVehicle:
SELECT Tyre.id, Tyre.timestamp, Tyre.rssi, Tyre.location, Tyre.pressure, Tyre.temperature, Tyre.battery, Tyre.isAlarm, Tyre.batteryVoltage, Tyre.batteryPercent FROM Tyre
INNER JOIN Vehicle ON Tyre.vehicleId = Vehicle.uuid
WHERE location = ? AND Vehicle.uuid = ?
ORDER BY timestamp DESC
LIMIT 1;

latestBySensorByVehicle:
SELECT id, timestamp, rssi, location, pressure, temperature, battery, isAlarm, batteryVoltage, batteryPercent FROM Tyre
WHERE id = ? AND vehicleId = ?
ORDER BY timestamp DESC
LIMIT 1;

latestBySensorByTyreLocationByVehicle:
SELECT id, timestamp, rssi, location, pressure, temperature, battery, isAlarm, batteryVoltage, batteryPercent FROM Tyre
WHERE id = ? AND location = ? AND vehicleId = ?
ORDER BY timestamp DESC
LIMIT 1;
